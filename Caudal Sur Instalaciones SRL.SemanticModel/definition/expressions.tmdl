expression Equivalencias_Proveedor =
		let
		    // DQ-10: cada forma en que aparece el proveedor en el sistema -> su ID. La clave va en MAYÚSCULAS y sin espacios sobrantes
		    Origen = #table(type table [Clave = text, ID_Proveedor = text], {
		        {"SANITARIOS DEL SUR S.A.", "PV01"},
		        {"SANITARIOS DEL SUR SA", "PV01"},
		        {"SANITARIOS DEL SUR", "PV01"},
		        {"TERMOFUSIÓN ATLÁNTICA", "PV02"},
		        {"TERMOFUSION ATLANTICA", "PV02"},
		        {"ACEROS Y TUBOS MAR CHIQUITA", "PV03"},
		        {"ACEROS Y TUBOS MAR CHIQ.", "PV03"},
		        {"PROTECCIÓN CONTRA INCENDIO BONAERENSE", "PV04"},
		        {"PROTECCION C/INCENDIO BONAERENSE", "PV04"},
		        {"PCI BONAERENSE", "PV04"},
		        {"VALVULERÍA INDUSTRIAL BATÁN", "PV05"},
		        {"VALVULERIA IND. BATAN", "PV05"},
		        {"BOMBAS HIDRÁULICAS CENTRO", "PV06"},
		        {"BOMBAS HIDRAULICAS CENTRO", "PV06"},
		        {"PERSONAL PROPIO (LIQUIDACIÓN)", "PV07"},
		        {"PERSONAL PROPIO", "PV07"},
		        {"LIQUIDACION SUELDOS", "PV07"},
		        {"EXCAVACIONES LAGUNA", "PV08"},
		        {"EXCAVACIONES LAGUNA SRL", "PV08"},
		        {"SOLDADURAS TÉCNICAS MDP", "PV09"},
		        {"SOLDADURAS TECNICAS MDP", "PV09"},
		        {"SOLDADURAS TEC. MDP", "PV09"},
		        {"ALQUILERES VIALE EQUIPOS", "PV10"},
		        {"ALQUILERES VIALE", "PV10"},
		        {"TRANSPORTES RUTA 2", "PV11"},
		        {"TRANSP. RUTA 2", "PV11"},
		        {"ESTUDIO ING. FERNÁNDEZ & ASOC.", "PV12"},
		        {"EST. ING. FERNÁNDEZ Y ASOC.", "PV12"},
		        {"ESTUDIO FERNANDEZ", "PV12"}
		    })
		in
		    Origen
	lineageTag: 5b18b683-53bc-4ea5-8f0e-d0574776edda

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression gastos_base =
		let
		    // Convierte los 4 formatos de fecha del sistema: 2026-01-02 | 07/07/2026 | 02/08/25 | 02-08-25 (día/mes/año)
		    ParseFecha = (t as nullable text) as nullable date =>
		        let s = Text.Trim(t ?? "") in
		        if s = "" then null
		        else if Text.Length(s) = 10 and Text.Middle(s, 4, 1) = "-" then
		            #date(Number.From(Text.Start(s, 4)), Number.From(Text.Middle(s, 5, 2)), Number.From(Text.End(s, 2)))
		        else
		            let p = Text.SplitAny(s, "/-"), a = Number.From(p{2}) in
		            #date(if a < 100 then 2000 + a else a, Number.From(p{1}), Number.From(p{0})),
		
		    Origen = Csv.Document(File.Contents("F:\FaroDatos\Proyecyos Portfolio\Caudal Sur Instalaciones SRL\Datos crudos\gastos_sistema.csv"),[Delimiter=";", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.None]),
		
		    // ===== 1. ESTRUCTURA =====
		    #"DQ-01 Quitar filas de título" = Table.Skip(Origen, 3),
		    #"DQ-01 Promover encabezados" = Table.PromoteHeaders(#"DQ-01 Quitar filas de título", [PromoteAllScalars=true]),
		    #"DQ-02 Quitar filas de pie" = Table.SelectRows(#"DQ-01 Promover encabezados", each Text.Trim([Nro Comprobante]) <> "" and not Text.StartsWith(Text.Upper([Nro Comprobante]), "TOTAL")),
		    #"DQ-15 Quitar Observaciones" = Table.RemoveColumns(#"DQ-02 Quitar filas de pie", {"Observaciones"}),
		
		    // ===== 2. TIPOS Y FORMATOS =====
		    #"DQ-04 Fecha a fecha" = Table.TransformColumns(#"DQ-15 Quitar Observaciones", {{"Fecha", ParseFecha, type nullable date}}),
		    // Saca espacios (también el invisible) y guiones, pasa a mayúsculas y rearma: " OB-001" / "ob-001" / "OB 001" / "OB001" -> "OB-001"
		    #"DQ-05 DQ-06 Normalizar Cod Obra" = Table.TransformColumns(#"DQ-04 Fecha a fecha", {{"Cod Obra", each let t = Text.Upper(Text.Remove(_ ?? "", {" ", "-", Character.FromNumber(160)})) in if t = "" then null else "OB-" & Text.End(t, 3), type nullable text}}),
		    // "$ 1.234.567,50" -> 1234567.5. #VALOR! queda nulo y va a Gastos_Observados
		    #"DQ-12 DQ-13 Importe a decimal" = Table.TransformColumns(#"DQ-05 DQ-06 Normalizar Cod Obra", {{"Importe", each let t = Text.Remove(_ ?? "", {"$", " ", Character.FromNumber(160)}) in if t = "" or t = "#VALOR!" then null else Number.FromText(t, "es-AR"), type nullable number}}),
		
		    // ===== 3. DUPLICADOS =====
		    // Si un comprobante está dos veces y una copia tiene #VALOR!, se queda la copia con importe válido
		    #"DQ-03 Importe válido primero" = Table.Buffer(Table.Sort(Table.AddColumn(#"DQ-12 DQ-13 Importe a decimal", "_orden", each if [Importe] = null then 1 else 0, Int64.Type), {{"_orden", Order.Ascending}, {"Nro Comprobante", Order.Ascending}})),
		    #"DQ-03 Quitar duplicados" = Table.RemoveColumns(Table.Distinct(#"DQ-03 Importe válido primero", {"Nro Comprobante"}), {"_orden"}),
		
		    // ===== 4. PROVEEDOR -> ID_Proveedor =====
		    #"DQ-10 DQ-11 Clave proveedor" = Table.AddColumn(#"DQ-03 Quitar duplicados", "Clave proveedor", each Text.Upper(Text.Trim([Proveedor])), type text),
		    #"DQ-10 Buscar equivalencia" = Table.NestedJoin(#"DQ-10 DQ-11 Clave proveedor", {"Clave proveedor"}, Equivalencias_Proveedor, {"Clave"}, "Eq", JoinKind.LeftOuter),
		    #"DQ-10 ID_Proveedor" = Table.ExpandTableColumn(#"DQ-10 Buscar equivalencia", "Eq", {"ID_Proveedor"}),
		
		    // ===== 5. RUBRO -> ID_Rubro =====
		    RubrosClave = Table.SelectColumns(Table.AddColumn(rubros, "Clave", each Text.Upper(Text.Trim([Rubro])), type text), {"Clave", "ID_Rubro"}),
		    #"DQ-08 Clave rubro" = Table.AddColumn(#"DQ-10 ID_Proveedor", "Clave rubro", each Text.Upper(Text.Trim([Rubro])), type text),
		    #"DQ-08 Buscar rubro" = Table.NestedJoin(#"DQ-08 Clave rubro", {"Clave rubro"}, RubrosClave, {"Clave"}, "Rb", JoinKind.LeftOuter),
		    #"DQ-08 ID_Rubro" = Table.ExpandTableColumn(#"DQ-08 Buscar rubro", "Rb", {"ID_Rubro"}, {"ID_Rubro original"}),
		    // Rubro vacío: se usa el rubro principal del proveedor (proveedores.csv)
		    #"DQ-09 Rubro principal del proveedor" = Table.ExpandTableColumn(Table.NestedJoin(#"DQ-08 ID_Rubro", {"ID_Proveedor"}, proveedores, {"ID_Proveedor"}, "Pv", JoinKind.LeftOuter), "Pv", {"ID_Rubro_Principal"}),
		    #"DQ-09 Completar rubro vacío" = Table.AddColumn(#"DQ-09 Rubro principal del proveedor", "ID_Rubro", each if [ID_Rubro original] = null then [ID_Rubro_Principal] else [ID_Rubro original], type nullable text),
		
		    // ===== 6. FILAS A OBSERVAR =====
		    #"DQ-07 DQ-09 DQ-13 DQ-14 Motivo observación" = Table.AddColumn(#"DQ-09 Completar rubro vacío", "Motivo observación", each
		        let m = Text.Combine(List.RemoveNulls({
		            if [Cod Obra] = null then "Sin obra (DQ-07)" else null,
		            if [Importe] = null then "Importe ilegible (DQ-13)" else null,
		            if [ID_Proveedor] = null then "Proveedor sin equivalencia (DQ-10)" else null,
		            if [ID_Rubro] = null then "Sin rubro (DQ-09)" else null,
		            if [Fecha] = null then "Sin fecha" else null,
		            if [Importe] <> null and [Importe] < 0 and [Tipo Comprobante] <> "Nota de crédito" then "Negativo que no es nota de crédito (DQ-14)" else null
		        }), " | ") in if m = "" then null else m, type nullable text),
		    #"Quitar columnas auxiliares" = Table.RemoveColumns(#"DQ-07 DQ-09 DQ-13 DQ-14 Motivo observación", {"Clave proveedor", "Clave rubro", "ID_Rubro original", "ID_Rubro_Principal"}),
		    #"Tipo cambiado" = Table.TransformColumnTypes(#"Quitar columnas auxiliares", {{"Nro Comprobante", type text}, {"Rubro", type text}, {"Proveedor", type text}, {"Tipo Comprobante", type text}, {"ID_Proveedor", type text}})
		in
		    #"Tipo cambiado"
	lineageTag: 9af254dc-6116-4f56-b3c9-3493595778fe

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

