		summarizeBy: none
		sourceColumn: Control estado

		annotation SummarizationSetBy = Automatic

	partition Certificaciones = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(File.Contents("F:\FaroDatos\Proyecyos Portfolio\Caudal Sur Instalaciones SRL\Datos crudos\certificaciones.xlsx"), null, true),
				    Certificaciones_Sheet = Origen{[Item="Certificaciones",Kind="Sheet"]}[Data],
				    #"Promover encabezados" = Table.PromoteHeaders(Certificaciones_Sheet, [PromoteAllScalars=true]),
				
				    // ===== 1. LIMPIEZA DE TEXTO =====
				    // Saca espacios y guiones, pasa a mayúsculas y rearma: " ob-001" / "OB 001" / "OB001" -> "OB-001"
				    #"DQ-29 DQ-30 Normalizar código de obra" = Table.TransformColumns(#"Promover encabezados", {{"Obra", each "OB-" & Text.End(Text.Upper(Text.Remove(Text.From(_), {" ", "-"})), 3), type text}}),
				    #"DQ-37 Recortar estado" = Table.TransformColumns(#"DQ-29 DQ-30 Normalizar código de obra", {{"Estado", each Text.Trim(Text.From(_)), type text}}),
				    #"DQ-31 N° Cert a entero" = Table.TransformColumnTypes(#"DQ-37 Recortar estado", {{"N° Cert.", Int64.Type}}),
				
				    // ===== 2. DIVIDIR CONCEPTO: tipo + período certificado =====
				    #"DQ-32 Tipo de certificado" = Table.AddColumn(#"DQ-31 N° Cert a entero", "Tipo", each if Text.StartsWith([Concepto], "Anticipo") then "Anticipo" else "Avance", type text),
				    // "Certificado de avance 08/2026" -> 01/08/2026 (el anticipo no tiene período)
				    #"DQ-32 Período certificado" = Table.AddColumn(#"DQ-32 Tipo de certificado", "Período certificado", each
				        if [Tipo] = "Avance"
				        then #date(Number.From(Text.End([Concepto], 4)), Number.From(Text.Start(Text.End([Concepto], 7), 2)), 1)
				        else null, type nullable date),
				    #"DQ-32 Quitar concepto" = Table.RemoveColumns(#"DQ-32 Período certificado", {"Concepto"}),
				
				    // ===== 3. TIPOS DE DATO =====
				    #"DQ-33 Fecha emisión a fecha" = Table.TransformColumnTypes(#"DQ-32 Quitar concepto", {{"Fecha emisión", type date}}, "es-AR"),
				    // Solo convierte las celdas de texto ("$ 1.234,50"); las que ya son número quedan igual
				    #"DQ-34 Importe a decimal" = Table.TransformColumns(#"DQ-33 Fecha emisión a fecha", {{"Importe", each if _ is text then Number.FromText(Text.Trim(Text.Replace(_, "$", "")), "es-AR") else _, type number}}),
				    // "pendiente" / "PENDIENTE" no son fechas: pasan a nulo
				    #"DQ-35 Fecha cobro texto a nulo" = Table.TransformColumns(#"DQ-34 Importe a decimal", {{"Fecha cobro", each if _ is text then null else _}}),
				    #"DQ-35 Fecha cobro a fecha" = Table.TransformColumnTypes(#"DQ-35 Fecha cobro texto a nulo", {{"Fecha cobro", type date}}, "es-AR"),
				
				    // ===== 4. REGLAS DE NEGOCIO =====
				    // Fuente de verdad: si tiene fecha de cobro, está cobrado. Pendiente + Reclamado = Pendiente de cobro
				    #"DQ-36 DQ-37 Estado de cobro" = Table.AddColumn(#"DQ-35 Fecha cobro a fecha", "Estado cobro", each if [Fecha cobro] <> null then "Cobrado" else "Pendiente de cobro", type text),
				    // Control: la columna Estado original tiene que coincidir con la fecha. Todo tiene que dar "OK"
				    #"DQ-36 Control contra Estado" = Table.AddColumn(#"DQ-36 DQ-37 Estado de cobro", "Control estado", each if ([Estado cobro] = "Cobrado") = ([Estado] = "Cobrado") then "OK" else "Revisar", type text),
				    #"Ordenar columnas" = Table.ReorderColumns(#"DQ-36 Control contra Estado", {"Obra", "N° Cert.", "Tipo", "Período certificado", "Fecha emisión", "Importe", "Fecha cobro", "Estado", "Estado cobro", "Control estado"})
				in
				    #"Ordenar columnas"

	annotation PBI_ResultType = Table

