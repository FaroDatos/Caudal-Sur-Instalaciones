table Avance
	lineageTag: 2d8c93e0-f620-44c2-af28-bce42b1f41a5

	column Obra
		dataType: string
		lineageTag: fa00b31c-5e5a-42bf-ad40-ed72fd56d43c
		summarizeBy: none
		sourceColumn: Obra

		annotation SummarizationSetBy = Automatic

	column Mes
		dataType: dateTime
		formatString: Short Date
		lineageTag: 9b24d1a2-9aab-4f74-93c5-53cc83d8e551
		summarizeBy: none
		sourceColumn: Mes

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column '% Planificado'
		dataType: double
		lineageTag: d99f3177-27c4-40c1-8c07-5b0158451318
		summarizeBy: sum
		sourceColumn: % Planificado

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column '% Real'
		dataType: double
		lineageTag: 893d924b-9685-4f5e-982f-c71ce0766467
		summarizeBy: sum
		sourceColumn: % Real

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition Avance = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(File.Contents("F:\FaroDatos\Proyecyos Portfolio\Caudal Sur Instalaciones SRL\Datos crudos\avance_obras.xlsx"), null, true),
				    Avance_Sheet = Origen{[Item="Avance",Kind="Sheet"]}[Data],
				    #"Promover encabezados" = Table.PromoteHeaders(Avance_Sheet, [PromoteAllScalars=true]),
				
				    // ===== 1. LIMPIEZA DE TEXTO =====
				    // "OB-001 Edificio Mirador del Golf" -> "OB-001" (el nombre ya está en Obras)
				    #"DQ-41 Código de obra" = Table.TransformColumns(#"Promover encabezados", {{"Obra", each Text.BeforeDelimiter(Text.Trim(Text.From(_)), " "), type text}}),
				    #"DQ-42 Serie mayúscula inicial" = Table.TransformColumns(#"DQ-41 Código de obra", {{"Serie", each Text.Proper(Text.Trim(Text.From(_))), type text}}),
				
				    // ===== 2. FORMATO LARGO =====
				    // Cada mes pasa a ser una fila. Los nulos fuera del período de cada obra se descartan solos (DQ-44)
				    #"DQ-38 DQ-44 Anular dinamización de meses" = Table.UnpivotOtherColumns(#"DQ-42 Serie mayúscula inicial", {"Obra", "Serie"}, "Mes", "Valor"),
				    // "jul-25" -> 01/07/2025
				    #"DQ-40 Mes a fecha" = Table.TransformColumns(#"DQ-38 DQ-44 Anular dinamización de meses", {{"Mes", each
				        let p = Text.Split(Text.Lower(Text.Trim(Text.From(_))), "-"),
				            m = List.PositionOf({"ene","feb","mar","abr","may","jun","jul","ago","sep","oct","nov","dic"}, p{0}) + 1
				        in #date(2000 + Number.From(p{1}), m, 1), type date}}),
				    // Tres escalas -> fracción 0-1: "29%" -> 0,29 | 29,2 -> 0,292 | 0,2923 queda igual
				    #"DQ-43 Valores a fracción 0-1" = Table.TransformColumns(#"DQ-40 Mes a fecha", {{"Valor", each
				        let n = if _ is text then
				                    (if Text.Contains(_, "%") then Number.FromText(Text.Trim(Text.Remove(_, "%")), "es-AR") / 100
				                     else Number.FromText(Text.Trim(_), "es-AR"))
				                else Number.From(_)
				        in if n > 1 then n / 100 else n, type number}}),
				
				    // ===== 3. PLANIFICADO Y REAL EN COLUMNAS =====
				    #"DQ-39 Dinamizar Serie" = Table.Pivot(#"DQ-43 Valores a fracción 0-1", {"Planificado", "Real"}, "Serie", "Valor"),
				    #"DQ-39 Renombrar series" = Table.RenameColumns(#"DQ-39 Dinamizar Serie", {{"Planificado", "% Planificado"}, {"Real", "% Real"}}),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"DQ-39 Renombrar series", {{"Obra", type text}, {"Mes", type date}, {"% Planificado", type number}, {"% Real", type number}})
				in
				    #"Tipo cambiado"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

