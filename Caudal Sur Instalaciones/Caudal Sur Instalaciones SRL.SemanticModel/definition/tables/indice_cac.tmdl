	partition indice_cac = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents("F:\FaroDatos\Proyecyos Portfolio\Caudal Sur Instalaciones SRL\Datos crudos\indice_cac.csv"),[Delimiter=",", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    // QuoteStyle.Csv: la Fuente "Derivado: oct-25 / 1,023 (...)" tiene una coma adentro de las comillas
				    #"Encabezados promovidos" = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos",{{"Anio", Int64.Type}, {"Mes", Int64.Type}, {"Fuente", type text}}),
				    // El CSV usa punto decimal: se convierte con Inglés (EE.UU.) para que 16939.5 no se lea como 169395
				    #"DQ-45 Índice con punto decimal" = Table.TransformColumnTypes(#"Tipo cambiado", {{"Indice_CAC", type number}}, "en-US"),
				    // Primer día del mes, para cruzar con Obras[Mes base CAC] y con el calendario
				    #"DQ-28 Período" = Table.AddColumn(#"DQ-45 Índice con punto decimal", "Período", each #date([Anio], [Mes], 1), type date)
				in
				    #"DQ-28 Período"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegación

