model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-AR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["gastos_sistema","Certificaciones","Avance","indice_cac","proveedores","rubros","Obras","Equivalencias_Proveedor","gastos_base","Gastos_Observados"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBIDesktopVersion = 2.129.1229.0 (24.05)

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table gastos_sistema
ref table Certificaciones
ref table Avance
ref table indice_cac
ref table proveedores
ref table rubros
ref table Obras
ref table Gastos_Observados
ref table Calendario
ref table Medidas

ref cultureInfo es-ES

